# ---- 앱 ----
HOST=127.0.0.1
PORT=3000

# 공공데이터포털(data.go.kr) 인증키 — 비워두면 샘플 데이터로 동작
# 활용신청 필요: 기상청_기상특보 조회서비스, 기상청_지진정보 조회서비스, 기상청_단기예보 조회서비스
# Encoding 키/Decoding 키 어느 쪽이든 사용 가능
DATA_GO_KR_KEY=

# HTTPS (휴대폰 GPS 사용 시 필요) — bash scripts/gen-cert.sh <공인IP> 로 생성
TLS_CERT=
TLS_KEY=

# 제보 설정
REPORT_TTL_HOURS=24
REPORT_RESOLVE_THRESHOLD=3
REPORT_RATE_LIMIT=5
REPORT_RATE_WINDOW_MIN=10
API_CACHE_MINUTES=5
# minitunnel http 모드가 넘겨주는 방문자 IP 헤더(mt-connection-ip) 신뢰 여부
TRUST_TUNNEL_HEADER=true

# ---- minitunnel (Cloudflare Tunnel 대체) ----
TUNNEL_SERVER=your.server.ip:port
TUNNEL_TOKEN=change-me
TUNNEL_REMOTE_PORT=8000
# http: 평문 HTTP (GPS 불가, 지도에서 위치 선택)  /  tcp: HTTPS 앱을 그대로 전달 (TLS_CERT 필요)
TUNNEL_MODE=http
TUNNEL_BIN=./minitunnel

# ---- 장소 검색 (OpenStreetMap Nominatim) ----
# 공개 서버 이용 정책: 앱 식별 User-Agent 필수, 연락처 이메일 권장, 초당 1회 이하 (서버에서 자동 조절)
NOMINATIM_URL=https://nominatim.openstreetmap.org
NOMINATIM_USER_AGENT=climate-safety-dashboard/0.1
NOMINATIM_EMAIL=
SEARCH_RATE_LIMIT=20
